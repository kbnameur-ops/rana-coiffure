# Base de données Postgres.
# - Renseignée : le site utilise cette base (production).
# - Absente : le site démarre sur un Postgres embarqué écrit dans data/pgdata,
#   pratique en local, aucune installation requise.
DATABASE_URL=

# Signature du cookie de session administrateur — CHANGEZ CETTE VALEUR
SESSION_SECRET=remplacez-moi-par-une-chaine-aleatoire-longue

# Compte administrateur créé au tout premier démarrage
ADMIN_EMAIL=admin@salon.fr
ADMIN_PASSWORD=changez-moi

# Emplacement de la base embarquée locale
DATA_DIR=./data

# Clé Google Cloud avec l'API « Places API (New) » activée, pour afficher les
# avis Google. À défaut, la clé peut être saisie dans l'espace salon.
GOOGLE_PLACES_API_KEY=

# Envoi des liens de connexion à l'espace client (Resend).
# Sans ces deux valeurs, l'espace client reste inaccessible : le lien est
# seulement tracé dans les journaux du serveur.
RESEND_API_KEY=
MAIL_FROM="Rana Coiffure <bonjour@votre-domaine.fr>"

# Adresse publique du site, utilisée pour construire les liens de connexion.
# Facultatif : déduit de la requête si absent.
SITE_URL=

# Protège la route d'entretien quotidienne appelée par la tâche planifiée.
CRON_SECRET=

# Fuseau horaire utilisé pour les créneaux
SALON_TIMEZONE=Europe/Paris
